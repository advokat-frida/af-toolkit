{
  "name": "@advokat-frida/af-toolkit",
  "version": "0.4.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/advokat-frida/af-toolkit.git"
  },
  "homepage": "https://toolkit.advokatfrida.com",
  "bugs": {
    "url": "https://github.com/advokat-frida/af-toolkit/issues"
  },
  "description": "The Advokat Frida Toolkit: four privacy tools, one repository, one design system.",
  "private": true,
  "type": "module",
  "scripts": {
    "build:tools": "node scripts/build-tools.mjs",
    "build:tools:full": "node scripts/build-tools.mjs --build",
    "typecheck": "node scripts/syntax-check.mjs",
    "build": "npm run build:web",
    "build:web": "node scripts/static-qa.mjs",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "design-gate": "node scripts/design-gate.mjs",
    "qa:static": "node scripts/static-qa.mjs",
    "qa:visual": "node scripts/visual-qa.mjs",
    "gate": "npm run design-gate && npm run typecheck && npm test && npm run build:web && npm run qa:visual && npm run qa:states && npm run qa:census",
    "qa": "npm run gate",
    "qa:states": "node scripts/state-proofs.mjs",
    "qa:census": "node scripts/style-census.mjs --check",
    "qa:census:report": "node scripts/style-census.mjs",
    "qa:access": "node scripts/access-integration.mjs",
    "qa:access:protocol": "node --test tests/integration/access-flow.test.mjs",
    "qa:access:browser": "node scripts/access-browser-qa.mjs",
    "qa:access:bridge": "node scripts/access-bridge-qa.mjs",
    "qa:access:flows": "node scripts/access-flow-browser-qa.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "esbuild": "0.28.1",
    "miniflare": "5.20260930.0-alpha",
    "parse5": "8.0.1",
    "playwright": "1.63.0",
    "wrangler": "^4.145.0"
  }
}
