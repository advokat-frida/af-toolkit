{
  "name": "@advokat-frida/the-toolkit",
  "version": "0.2.0",
  "description": "The Advokat Frida Toolkit: five privacy and AI tools, one repository, one design system.",
  "private": true,
  "type": "module",
  "scripts": {
    "build:tools": "node scripts/build-tools.mjs",
    "build:tools:full": "node scripts/build-tools.mjs --build",
    "typecheck": "node scripts/syntax-check.mjs",
    "build": "npm run build:web",
    "build:web": "node scripts/static-qa.mjs",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "design-gate": "node scripts/design-gate.mjs",
    "qa:static": "node scripts/static-qa.mjs",
    "qa:visual": "node scripts/visual-qa.mjs",
    "gate": "npm run design-gate && npm run typecheck && npm test && npm run build:web && npm run qa:visual",
    "qa": "npm run gate"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "1.61.0"
  }
}
