{
  "name": "@advokat-frida/the-toolkit",
  "version": "0.1.1",
  "description": "Private integration shell for the Advokat Frida Toolkit.",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-tools.mjs",
    "typecheck": "node scripts/syntax-check.mjs",
    "build": "npm run build:web",
    "build:web": "node scripts/static-qa.mjs",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "qa:static": "node scripts/static-qa.mjs",
    "qa:visual": "node scripts/visual-qa.mjs",
    "qa": "npm run typecheck && npm run test && npm run build:web && npm run qa:visual"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "1.61.0"
  }
}
