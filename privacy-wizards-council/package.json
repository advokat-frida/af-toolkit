{
  "name": "@advokat-frida/privacy-wizards-council",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "registry": "node scripts/registry/generate.mjs",
    "dev": "npm run registry && vite --host 127.0.0.1",
    "build": "npm run registry && vite build && node scripts/build-singlefile.mjs",
    "test": "npm run registry && vitest run",
    "audit:style": "node scripts/audit-style.mjs",
    "check": "npm run test && npm run audit:style && npm run build && node scripts/verify-artifact.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "jsdom": "^26.1.0",
    "svelte": "^5.38.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^5.0.0"
  }
}
