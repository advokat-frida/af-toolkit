{
  "name": "@advokat-frida/privacy-wizards-council",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "extract:legacy": "node scripts/extract-legacy-data.mjs",
    "dev": "npm run extract:legacy && vite --host 127.0.0.1",
    "build": "npm run extract:legacy && vite build && node scripts/build-singlefile.mjs",
    "test": "npm run extract:legacy && vitest run",
    "audit:style": "node scripts/audit-style.mjs",
    "check": "npm run test && npm run audit:style && npm run build && node scripts/verify-artifact.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "jsdom": "^26.1.0",
    "svelte": "^5.38.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.4"
  }
}
